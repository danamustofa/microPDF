{
  "name": "micropdf",
  "version": "2026.3.0",
  "description": "Simple and elegant PDF compression tool",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "keywords": [
    "pdf",
    "compression",
    "electron"
  ],
  "author": "danamustofa",
  "license": "MIT",
  "devDependencies": {
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.micropdf.app",
    "productName": "microPDF",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "compress_pdf.py",
      "requirements.txt"
    ],
    "extraResources": [
      {
        "from": "compress_pdf.py",
        "to": "compress_pdf.py"
      },
      {
        "from": "vendor/ghostscript",
        "to": "ghostscript"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "electron/assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "electron/assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "electron/assets/icon.png"
    }
  }
}
